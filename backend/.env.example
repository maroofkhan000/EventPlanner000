NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wedding-planner?retryWrites=true&w=majority
JWT_SECRET=<a-long-random-secret>
CLIENT_URL=http://localhost:3000

# Master account (run: npm run create-admin)
ADMIN_NAME=Master Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<choose-a-strong-password>

# UPI payments go straight to this UPI ID
UPI_ID=yourname@okaxis
UPI_PAYEE_NAME=Blissful Weddings

# Photo uploads go to Cloudinary when these are set (needed on Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
